{
  "expo": {
    "name": "e-City Challenge",
    "slug": "my-app",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icons/appstore.png",
    "scheme": "e-city challenge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for activities."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/appstore.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCpPnSQGjHiP2wy-Rokvwk-l99DVL9EjxA"
        }
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.ecity.challenge"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/Vector.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app needs access to your camera to take photos for activities.",
          "microphonePermission": "This app needs access to your microphone for video recording.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/appstore.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91e079f9-2147-4f58-b8e5-46af92c46f1b"
      }
    }
  }
}
